# ─────────────────────────────────────────────────────────────
# Banco de dados
# ─────────────────────────────────────────────────────────────
# Local (docker-compose): use as variáveis discretas abaixo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=appointment
DB_PASSWORD=appoint123
DB_NAME=appointmentdb

# Produção (TiDB Cloud / Aiven / Railway): basta a connection string.
# Quando DATABASE_URL está definido, ele tem prioridade sobre as variáveis acima.
# Ex.: mysql://usuario:senha@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/appointmentdb
# DATABASE_URL=
# Ativa SSL/TLS (obrigatório no TiDB Cloud e na maioria dos provedores cloud)
# DB_SSL=true

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
SECRET_KEY=seu_secret_jwt_super_seguro_aqui_mude_em_producao

# ─────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# Google Calendar (OAuth)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Token secreto exigido no header `x-sync-token` do endpoint POST /api/sync/google
# (sincronização reversa do Google Calendar). Também é usado como token do canal
# de push (echoado em X-Goog-Channel-Token). Gere um valor aleatório forte.
GOOGLE_SYNC_TOKEN=
# URL pública do webhook que recebe as push notifications do Google Calendar.
# Precisa estar num domínio verificado no Google Cloud Console.
# Ex.: https://api.seudominio.com/api/google/notifications
GOOGLE_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────
# Token que você define no webhook do Meta (verificação do endpoint)
WPP_VERIFY_TOKEN=seu_token_de_verificacao_webhook
# Token de acesso permanente da API do WhatsApp
WPP_TOKEN=
