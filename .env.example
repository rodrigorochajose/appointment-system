# ─────────────────────────────────────────────────────────────
# Banco de dados
# ─────────────────────────────────────────────────────────────
# Local (docker-compose)
DATABASE_URL_DEV=

# Produção (TiDB Cloud / Aiven / Railway)
DATABASE_URL_PROD=
# Ativa SSL/TLS (obrigatório no TiDB Cloud e na maioria dos provedores cloud)
DB_SSL=true

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Google Calendar (OAuth)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Token secreto exigido no header `x-sync-token` do endpoint POST /api/sync/google
# (sincronização reversa do Google Calendar). Gere um valor aleatório forte.
GOOGLE_SYNC_TOKEN=
# URL pública do webhook que recebe as push notifications do Google Calendar.
# Precisa estar num domínio verificado no Google Cloud Console.
# Ex.: https://api.seudominio.com/api/google/notifications
GOOGLE_WEBHOOK_URL=

# Server
NODE_ENV=
PORT= 

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────
# Token que você define no webhook do Meta (verificação do endpoint)
WPP_VERIFY_TOKEN=
# Token de acesso permanente da API do WhatsApp
WPP_TOKEN=